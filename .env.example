# ── Banco de dados (Docker Compose + Backend) ──────────────────────────
POSTGRES_USER=YOUR_USERNAME
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=YOUR_DATABASE

# Porta exposta no host para o PostgreSQL (útil se a 5432 já estiver em uso)
DB_PORT=5432

# ── Backend (.NET) ─────────────────────────────────────────────────────
# Connection string montada a partir das variáveis acima.
# Sobrescreva se precisar de parâmetros extras (SSL, pooling, etc.)
CONNECTION_STRING=Host=localhost;Port=5432;Database=YOUR_DATABASE;Username=YOUR_USERNAME;Password=YOUR_PASSWORD

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

